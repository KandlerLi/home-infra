[Unit]
Description=Lightweight Kubernetes
Documentation=https://k3s.io
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart={{ k3s_node_binary_path }} server
KillMode=process
Delegate=yes
# Having non-zero Limit*s causes performance problems due to accounting
# overhead in the kernel -- cgroups do container-local accounting
# instead. The settings below are copied verbatim from k3s's own
# upstream systemd unit
# (https://github.com/k3s-io/k3s/blob/master/k3s.service), not
# guessed -- getting these wrong causes real runtime breakage under
# containerd, not just cosmetic issues. Two upstream lines are
# deliberately dropped as inapplicable here: EnvironmentFile stanzas
# pointing at files this role never creates, and an ExecStartPre check
# for RHEL-family cloud images' nm-cloud-setup service, which doesn't
# exist on Debian.
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
TimeoutStartSec=0
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
