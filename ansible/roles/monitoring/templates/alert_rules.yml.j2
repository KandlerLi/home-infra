groups:
  - name: host_health
    rules:
      - alert: HostDown
        expr: up{job="node_exporter"} == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "The homeserver's own node_exporter is unreachable"
          description: >-
            Prometheus can no longer scrape node_exporter -- the host may
            be down, or Docker itself may have stopped.

      - alert: RootDiskAlmostFull
        expr: >-
          100 * (1 - node_filesystem_avail_bytes{mountpoint="/"}
          / node_filesystem_size_bytes{mountpoint="/"})
          > {{ monitoring_alert_disk_full_percent }}
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Root disk is over {{ monitoring_alert_disk_full_percent }}% full"
          description: >-
            Prometheus's own TSDB lives here too -- a full root disk stops
            monitoring itself, not just whatever else fills it up.

  - name: container_health
    rules:
      - alert: ContainerDown
        # container_last_seen is keyed by cAdvisor's own "id" label too
        # (the container's cgroup path), which changes to a brand-new
        # value every time site.yml *recreates* a container (a config
        # change, not just a restart) -- confirmed live. The old id's
        # series then just stops updating and sits frozen in Prometheus
        # while a fresh series starts under the new id, so comparing
        # staleness per exact label set fires this alert for that dead
        # ghost series on every ordinary recreate, even though the
        # actual current container is healthy. Aggregating by the
        # stable "name" label first (taking the freshest id's value)
        # fixes that: as long as some container with this name has
        # been seen recently, the alert doesn't fire.
        expr: >-
          absent(container_last_seen{name!=""})
          or (time() - max by (name) (container_last_seen{name!=""})) > 120
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Container {{ '{{' }} $labels.name {{ '}}' }} is not reporting"
          description: >-
            cAdvisor hasn't seen this container recently -- it may have
            stopped or be stuck restarting.

  - name: service_reachability
    rules:
      - alert: ServiceUnreachable
        expr: probe_success == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "{{ '{{' }} $labels.instance {{ '}}' }} failed its reachability probe"
          description: >-
            blackbox_exporter could not reach this URL for at least 5
            minutes.

  - name: certificate_expiry
    rules:
      - alert: CertificateExpiringSoon
        expr: >-
          (probe_ssl_earliest_cert_expiry - time()) / 86400
          < {{ monitoring_alert_cert_expiry_days }}
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "TLS certificate for {{ '{{' }} $labels.instance {{ '}}' }} expires within {{ monitoring_alert_cert_expiry_days }} days"
          description: >-
            Traefik's own ACME renewal should handle this automatically --
            this alert exists to catch the case where it doesn't.

  - name: blocky_health
    rules:
      - alert: BlockyQueryLogStale
        # Closes a real, confirmed-live gap: Blocky's own query-log
        # Postgres writer has no reconnect logic at all (upstream
        # behavior, not fixable here) -- an ~18h silent gap after
        # Postgres restarted mid-Pod-lifetime was found once, only by
        # chance. Blocky's own `up` metric (the `blocky` scrape job)
        # stays green the whole time this happens, so nothing else in
        # this file would ever catch a repeat -- DNS resolution itself
        # keeps working fine even during the gap, only the log write
        # path is affected. pg_stat_user_tables_n_tup_ins is a
        # monotonic counter of rows inserted into a table (the
        # blocky_postgres_exporter job's own default collector, no
        # custom query needed) -- zero increase over the window means
        # zero new queries got logged.
        expr: >-
          absent(pg_stat_user_tables_n_tup_ins{relname="log_entries"})
          or (increase(pg_stat_user_tables_n_tup_ins{relname="log_entries"}[10m]) == 0)
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Blocky's query log hasn't recorded a new DNS query in over 10 minutes"
          description: >-
            Either the postgres_exporter scrape target itself is down
            (absent()), or Blocky's own writer silently stopped logging
            after a Postgres restart -- Blocky itself is very likely
            still resolving DNS fine either way. Check the blocky Pod's
            own postgres/postgres-exporter container logs; restarting
            the blocky Pod forces Blocky to reconnect its writer.

{% if monitoring_k3s_node_health_enabled | bool %}
  - name: k3s_node_health
    rules:
      - alert: K3sNodeDown
        expr: up{job="k3s_node_exporter"} == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "{{ '{{' }} $labels.node {{ '}}' }}'s own node-exporter is unreachable"
          description: >-
            Prometheus can no longer scrape this k3s node's own
            node-exporter DaemonSet Pod -- the node itself may be down,
            or kubelet may have stopped scheduling Pods on it.

      # Real, sustained usage -- not the request-vs-actual bookkeeping
      # gap kube-state-metrics exists to surface on the dashboard
      # itself (that's a capacity-planning signal to look at, not
      # something worth waking anyone up over).
      - alert: K3sNodeCPUHigh
        expr: >-
          100 - (avg by (node) (rate(node_cpu_seconds_total{job="k3s_node_exporter", mode="idle"}[5m])) * 100)
          > 90
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "{{ '{{' }} $labels.node {{ '}}' }} has been over 90% CPU for 10+ minutes"
          description: >-
            Sustained real CPU usage, not a request/limit bookkeeping
            gap -- check `kubectl top pods` on this node for what's
            actually driving it.

      - alert: K3sNodeMemoryHigh
        expr: >-
          100 * (1 - (node_memory_MemAvailable_bytes{job="k3s_node_exporter"}
          / node_memory_MemTotal_bytes{job="k3s_node_exporter"}))
          > 90
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "{{ '{{' }} $labels.node {{ '}}' }} has been over 90% memory for 10+ minutes"
          description: >-
            Sustained real memory usage -- a node this full risks the
            kubelet evicting Pods to reclaim space.

      - alert: K3sNodeDiskAlmostFull
        expr: >-
          100 * (1 - (node_filesystem_avail_bytes{job="k3s_node_exporter", mountpoint="/"}
          / node_filesystem_size_bytes{job="k3s_node_exporter", mountpoint="/"}))
          > {{ monitoring_alert_disk_full_percent }}
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "{{ '{{' }} $labels.node {{ '}}' }}'s root disk is over {{ monitoring_alert_disk_full_percent }}% full"
          description: >-
            Same threshold as the homeserver's own RootDiskAlmostFull --
            a full root disk on either k3s node risks containerd/kubelet
            themselves failing, not just workloads on it.
{% endif %}
