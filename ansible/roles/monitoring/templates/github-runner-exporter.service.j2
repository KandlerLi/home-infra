[Unit]
Description=GitHub self-hosted runner status exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ monitoring_github_runner_exporter_service_user }}
Group={{ monitoring_github_runner_exporter_service_user }}
Environment="GITHUB_OWNER={{ monitoring_github_runner_exporter_owner }}"
Environment="GITHUB_REPOSITORIES={{ monitoring_github_runner_exporter_repositories | join(',') }}"
Environment="GITHUB_TOKEN_FILE={{ monitoring_data_dir }}/github-runner-exporter/token"
Environment="LISTEN_PORT={{ monitoring_github_runner_exporter_port }}"
Environment="POLL_SECONDS={{ monitoring_github_runner_exporter_poll_seconds }}"
ExecStart=/usr/bin/python3 {{ monitoring_github_runner_exporter_install_dir }}/github_runner_exporter.py
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
MemoryMax=64M
TasksMax=32

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6
# No address allowlist: api.github.com has no fixed IP.
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
