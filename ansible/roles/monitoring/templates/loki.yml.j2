auth_enabled: false

server:
  http_listen_address: {{ monitoring_loki_bind_address }}
  http_listen_port: {{ monitoring_loki_port }}
  grpc_listen_address: 127.0.0.1
  grpc_listen_port: {{ monitoring_loki_grpc_port }}
  log_level: warn

common:
  instance_addr: 127.0.0.1
  path_prefix: /loki
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory
  storage:
    filesystem:
      chunks_directory: /loki/chunks
      rules_directory: /loki/rules

schema_config:
  configs:
    - from: "2026-11-01"
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h

limits_config:
  retention_period: {{ monitoring_loki_retention_period }}
  reject_old_samples: true
  reject_old_samples_max_age: {{ monitoring_alloy_journal_max_age }}

{% if monitoring_loki_minecraft_alerts_enabled | bool %}
# Rules are read from common's rules_directory, per tenant ("fake" without auth).
ruler:
  alertmanager_url: http://{{ monitoring_alertmanager_upstream }}
  rule_path: /loki/rules-temp
  enable_api: false

{% endif %}
compactor:
  working_directory: /loki/compactor
  retention_enabled: true
  delete_request_store: filesystem

analytics:
  reporting_enabled: false
