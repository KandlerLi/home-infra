global:
  resolve_timeout: 5m

route:
  receiver: dual-channel
  group_by: ["alertname"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: dual-channel
    # Posts to the local ntfy_relay service (127.0.0.1, see monitoring's
    # ntfy-relay.service), not straight to ntfy.sh -- Alertmanager's
    # webhook_configs can't template its own JSON payload into something
    # ntfy understands, so the relay reformats it into a readable
    # title/message before republishing to ntfy's own API.
    webhook_configs:
      - url: http://{{ monitoring_bind_address }}:{{ monitoring_ntfy_relay_port }}/webhook
        send_resolved: true
    email_configs:
      - to: {{ monitoring_alert_email }}
        from: {{ monitoring_ses_from_address }}
        smarthost: {{ monitoring_ses_smtp_host }}:{{ monitoring_ses_smtp_port }}
        auth_username: {{ monitoring_ses_smtp_username }}
        auth_password: {{ monitoring_ses_smtp_password }}
        require_tls: true
        send_resolved: true
