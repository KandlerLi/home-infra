global:
  scrape_interval: {{ monitoring_prometheus_scrape_interval }}
  evaluation_interval: {{ monitoring_prometheus_scrape_interval }}

rule_files:
  - /etc/prometheus/alert_rules.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - {{ monitoring_alertmanager_upstream }}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - 127.0.0.1:{{ monitoring_prometheus_port }}

  - job_name: node_exporter
    static_configs:
      - targets:
          - 127.0.0.1:{{ monitoring_node_exporter_port }}

  - job_name: cadvisor
    static_configs:
      - targets:
          - 127.0.0.1:{{ monitoring_cadvisor_port }}

{% if monitoring_blocky_enabled | bool %}
  # Blocky exposes metrics natively.
  - job_name: blocky
    static_configs:
      - targets:
          - {{ monitoring_blocky_upstream }}

  # Postgres has no native endpoint, hence the exporter sidecar.
  - job_name: blocky_postgres_exporter
    static_configs:
      - targets:
          - {{ monitoring_blocky_postgres_exporter_upstream }}
{% endif %}

{% if monitoring_k3s_node_health_enabled | bool %}
  # Its own job name: k3s-node-health.json filters on it, since the metric names are identical.
  - job_name: k3s_node_exporter
    static_configs:
{% for target in monitoring_k3s_node_exporter_targets %}
      - targets:
          - {{ target.address }}
        labels:
          node: {{ target.node }}
{% endfor %}

  - job_name: k3s_kube_state_metrics
    static_configs:
      - targets:
          - {{ monitoring_k3s_kube_state_metrics_upstream }}
{% endif %}

{% if monitoring_github_runner_exporter_enabled | bool %}
  - job_name: github_runner_exporter
    static_configs:
      - targets:
          - 127.0.0.1:{{ monitoring_github_runner_exporter_port }}
{% endif %}

{% if monitoring_k3s_kubelet_metrics_enabled | bool %}
  # Same metric names as the cadvisor job above: queries must filter on job.
  - job_name: k3s_kubelet_cadvisor
    scheme: https
    metrics_path: /metrics/cadvisor
    authorization:
      credentials_file: /etc/prometheus/k3s/kubelet-token
    tls_config:
      ca_file: /etc/prometheus/k3s/server-ca.crt
    static_configs:
{% for target in monitoring_k3s_kubelet_targets %}
      - targets:
          - {{ target.address }}
        labels:
          node: {{ target.node }}
{% endfor %}
    # Allowlist: kubelet's cAdvisor exports far more series than the dashboards use.
    metric_relabel_configs:
      - source_labels: [__name__]
        regex: >-
          container_(cpu_usage_seconds_total|cpu_cfs_periods_total|cpu_cfs_throttled_periods_total|memory_working_set_bytes|spec_memory_limit_bytes|oom_events_total|network_receive_bytes_total|network_transmit_bytes_total|fs_reads_bytes_total|fs_writes_bytes_total)
        action: keep
{% endif %}

  # blackbox's multi-target pattern: each target is a query param on /probe.
  - job_name: blackbox_http
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
{% for target in monitoring_probe_targets %}
          - {{ target }}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:{{ monitoring_blackbox_exporter_port }}

  # The same pattern for targets behind Authelia forward-auth.
  - job_name: blackbox_http_authenticated
    metrics_path: /probe
    params:
      module: [http_2xx_or_401]
    static_configs:
      - targets:
{% for target in monitoring_probe_targets_authenticated %}
          - {{ target }}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:{{ monitoring_blackbox_exporter_port }}

  # Per-target module, carried as a label into the module param.
  - job_name: blackbox_tcp
    metrics_path: /probe
    static_configs:
{% for probe in monitoring_probe_targets_tcp %}
      - targets:
          - {{ probe.target }}
        labels:
          module: {{ probe.module }}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [module]
        target_label: __param_module
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:{{ monitoring_blackbox_exporter_port }}
