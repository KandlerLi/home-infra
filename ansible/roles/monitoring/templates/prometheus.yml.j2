global:
  scrape_interval: {{ monitoring_prometheus_scrape_interval }}
  evaluation_interval: {{ monitoring_prometheus_scrape_interval }}

rule_files:
  - /etc/prometheus/alert_rules.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - {{ monitoring_alertmanager_upstream }}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - 127.0.0.1:{{ monitoring_prometheus_port }}

  - job_name: node_exporter
    static_configs:
      - targets:
          - 127.0.0.1:{{ monitoring_node_exporter_port }}

  - job_name: cadvisor
    static_configs:
      - targets:
          - 127.0.0.1:{{ monitoring_cadvisor_port }}

{% if monitoring_blocky_enabled | bool %}
  # Blocky exposes real Prometheus metrics natively, unlike
  # node_exporter/cAdvisor/blackbox_exporter, which needed dedicated
  # sidecar exporters -- scraped directly, no /probe proxying needed.
  - job_name: blocky
    static_configs:
      - targets:
          - 127.0.0.1:{{ monitoring_blocky_http_port }}
{% endif %}

  # blackbox_exporter's own multi-target pattern: each real target is
  # passed as a "target" query param on a single /probe endpoint, not
  # scraped directly -- the exporter does the actual probing per request.
  - job_name: blackbox_http
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
{% for target in monitoring_probe_targets %}
          - {{ target }}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:{{ monitoring_blackbox_exporter_port }}

  # Same pattern, but for targets behind Basic Auth this role has no
  # plaintext credential for -- see monitoring_probe_targets_authenticated
  # in defaults/main.yml and blackbox.yml.j2's http_2xx_or_401 module.
  - job_name: blackbox_http_authenticated
    metrics_path: /probe
    params:
      module: [http_2xx_or_401]
    static_configs:
      - targets:
{% for target in monitoring_probe_targets_authenticated %}
          - {{ target }}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:{{ monitoring_blackbox_exporter_port }}
