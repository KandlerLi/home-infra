global:
  scrape_interval: {{ monitoring_prometheus_scrape_interval }}
  evaluation_interval: {{ monitoring_prometheus_scrape_interval }}

rule_files:
  - /etc/prometheus/alert_rules.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - {{ monitoring_alertmanager_upstream }}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - 127.0.0.1:{{ monitoring_prometheus_port }}

  - job_name: node_exporter
    static_configs:
      - targets:
          - 127.0.0.1:{{ monitoring_node_exporter_port }}

  - job_name: cadvisor
    static_configs:
      - targets:
          - 127.0.0.1:{{ monitoring_cadvisor_port }}

{% if monitoring_blocky_enabled | bool %}
  # Blocky exposes metrics natively.
  - job_name: blocky
    static_configs:
      - targets:
          - {{ monitoring_blocky_upstream }}

  # Postgres has no native endpoint, hence the exporter sidecar.
  - job_name: blocky_postgres_exporter
    static_configs:
      - targets:
          - {{ monitoring_blocky_postgres_exporter_upstream }}
{% endif %}

{% if monitoring_k3s_node_health_enabled | bool %}
  # Its own job name: k3s-node-health.json filters on it, since the metric names are identical.
  - job_name: k3s_node_exporter
    static_configs:
{% for target in monitoring_k3s_node_exporter_targets %}
      - targets:
          - {{ target.address }}
        labels:
          node: {{ target.node }}
{% endfor %}

  - job_name: k3s_kube_state_metrics
    static_configs:
      - targets:
          - {{ monitoring_k3s_kube_state_metrics_upstream }}
{% endif %}

  # blackbox's multi-target pattern: each target is a query param on /probe.
  - job_name: blackbox_http
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
{% for target in monitoring_probe_targets %}
          - {{ target }}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:{{ monitoring_blackbox_exporter_port }}

  # The same pattern for targets behind Authelia forward-auth.
  - job_name: blackbox_http_authenticated
    metrics_path: /probe
    params:
      module: [http_2xx_or_401]
    static_configs:
      - targets:
{% for target in monitoring_probe_targets_authenticated %}
          - {{ target }}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:{{ monitoring_blackbox_exporter_port }}
