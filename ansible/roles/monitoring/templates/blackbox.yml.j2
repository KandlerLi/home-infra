modules:
  http_2xx:
    prober: http
    timeout: 10s
    http:
      method: GET
      valid_status_codes: []
      follow_redirects: true
      preferred_ip_protocol: ip4
      tls_config:
        insecure_skip_verify: false

  # For targets behind Authelia forward-auth: 401 counts as reachable.
  http_2xx_or_401:
    prober: http
    timeout: 10s
    http:
      method: GET
      valid_status_codes: [200, 401]
      follow_redirects: true
      preferred_ip_protocol: ip4
      tls_config:
        insecure_skip_verify: false

  # Mail: the server greeting, and on port 25 the upgrade to TLS, so a TLS or certificate problem fails the probe.
  smtp_starttls:
    prober: tcp
    timeout: 10s
    tcp:
      preferred_ip_protocol: ip4
      # Reached as the MX host, but Stalwart's certificate names only this.
      tls_config:
        server_name: stalwart.jkandler.de
      query_response:
        - expect: "^220"
        - send: "EHLO blackbox.jkandler.de\r"
        - expect: "^250[ -]STARTTLS"
        - send: "STARTTLS\r"
        - expect: "^220"
        - starttls: true
        - send: "EHLO blackbox.jkandler.de\r"
        - expect: "^250 "
        - send: "QUIT\r"

  smtps:
    prober: tcp
    timeout: 10s
    tcp:
      preferred_ip_protocol: ip4
      tls: true
      query_response:
        - expect: "^220"
        - send: "QUIT\r"

  imaps:
    prober: tcp
    timeout: 10s
    tcp:
      preferred_ip_protocol: ip4
      tls: true
      query_response:
        - expect: "^\\* OK"
        - send: "a1 LOGOUT\r"
