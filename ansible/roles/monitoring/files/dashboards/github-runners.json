{
  "title": "GitHub Runners",
  "uid": "monitoring-github-runners",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "monitoring"
  ],
  "panels": [
    {
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "title": "Runners ready",
      "type": "stat",
      "description": "Runner pods with every container ready (runner, dind, pruner).",
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "NO DATA",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_deployment_status_replicas_ready{deployment=~\"github-runner-.+\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      }
    },
    {
      "title": "Runners not ready",
      "type": "stat",
      "description": "Expected minus ready. After a homeserver reboot this stays high for a while: see the seeding panel.",
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "NO DATA",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_deployment_spec_replicas{deployment=~\"github-runner-.+\"}) - sum(kube_deployment_status_replicas_ready{deployment=~\"github-runner-.+\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      }
    },
    {
      "title": "Seeding runner install",
      "type": "stat",
      "description": "Pods still copying the runner install into their emptyDir. All 16 at once saturate the HDD-backed VM disk.",
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "NO DATA",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_pod_init_container_status_running{container=\"seed-runner-install\", pod=~\"github-runner-.+\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 4,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      }
    },
    {
      "title": "Runner restarts (24h)",
      "type": "stat",
      "description": "Runners are ephemeral: every finished job restarts the runner container, so this is roughly jobs run. A reboot adds one per pod.",
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "NO DATA",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(kube_pod_container_status_restarts_total{container=\"runner\", pod=~\"github-runner-.+\"}[24h]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 5,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      }
    },
    {
      "title": "dind/pruner restarts (24h)",
      "type": "stat",
      "description": "These sidecars should not restart on their own; a reboot restarts each once.",
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "NO DATA",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(kube_pod_container_status_restarts_total{container=~\"dind|pruner\", pod=~\"github-runner-.+\"}[24h]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 6,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      }
    },
    {
      "title": "k3s-node-2 iowait",
      "type": "stat",
      "description": "High iowait at low CPU means the runners wait on the disk, not on compute.",
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "noValue": "NO DATA",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 20
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg(rate(node_cpu_seconds_total{job=\"k3s_node_exporter\", node=\"k3s-node-2\", mode=\"iowait\"}[5m])) * 100",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 7,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      }
    },
    {
      "title": "Runner pod ready",
      "type": "state-timeline",
      "description": "Per runner slot: green when the pod and all its containers are ready.",
      "options": {
        "showValue": "never",
        "rowHeight": 0.8,
        "mergeValues": true,
        "alignValue": "left"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "not ready"
                },
                "1": {
                  "text": "ready"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (runner) (label_replace(kube_pod_status_ready{condition=\"true\", pod=~\"github-runner-.+\"}, \"runner\", \"$1\", \"pod\", \"github-runner-(.+)-[a-z0-9]+-[a-z0-9]+\"))",
          "legendFormat": "{{runner}}",
          "refId": "A"
        }
      ],
      "id": 8,
      "gridPos": {
        "h": 12,
        "w": 16,
        "x": 0,
        "y": 5
      }
    },
    {
      "title": "Containers waiting right now",
      "type": "table",
      "description": "Empty is good. Shows each runner container stuck in a waiting state and why (CrashLoopBackOff, ContainerCreating, ...).",
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "none"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "indexByName": {
              "runner": 0,
              "container": 1,
              "reason": 2
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (runner, container, reason) (label_replace(kube_pod_container_status_waiting_reason{pod=~\"github-runner-.+\"}, \"runner\", \"$1\", \"pod\", \"github-runner-(.+)-[a-z0-9]+-[a-z0-9]+\")) > 0",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "id": 9,
      "gridPos": {
        "h": 12,
        "w": 8,
        "x": 16,
        "y": 5
      }
    },
    {
      "type": "row",
      "title": "Activity",
      "collapsed": false,
      "panels": [],
      "id": 10,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      }
    },
    {
      "title": "Runner restarts per hour by repo (\u2248 jobs)",
      "type": "timeseries",
      "description": "Rolling 1h window. Ephemeral runners restart after every job; a reboot shows up as one restart per pod.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (repo) (label_replace(increase(kube_pod_container_status_restarts_total{container=\"runner\", pod=~\"github-runner-.+\"}[1h]), \"repo\", \"$1\", \"pod\", \"github-runner-(.+)-[0-9]+-[a-z0-9]+-[a-z0-9]+\"))",
          "legendFormat": "{{repo}}",
          "refId": "A"
        }
      ],
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      }
    },
    {
      "title": "dind/pruner restarts per hour",
      "type": "timeseries",
      "description": "Anything here outside a reboot means a sidecar is crashing.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (runner, container) (label_replace(increase(kube_pod_container_status_restarts_total{container=~\"dind|pruner\", pod=~\"github-runner-.+\"}[1h]), \"runner\", \"$1\", \"pod\", \"github-runner-(.+)-[a-z0-9]+-[a-z0-9]+\")) > 0",
          "legendFormat": "{{runner}} {{container}}",
          "refId": "A"
        }
      ],
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      }
    },
    {
      "type": "row",
      "title": "Per container (kubelet cAdvisor)",
      "collapsed": false,
      "panels": [],
      "id": 22,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      }
    },
    {
      "title": "CPU by repo and container",
      "type": "timeseries",
      "description": "Cores, 5m rate, summed over a repo's runner pods.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 30,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (repo, container) (label_replace(rate(container_cpu_usage_seconds_total{job=\"k3s_kubelet_cadvisor\", pod=~\"github-runner-.+\", container!=\"\"}[5m]), \"repo\", \"$1\", \"pod\", \"github-runner-(.+)-[0-9]+-[a-z0-9]+-[a-z0-9]+\"))",
          "legendFormat": "{{repo}} {{container}}",
          "refId": "A"
        }
      ],
      "id": 23,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 27
      }
    },
    {
      "title": "Memory by repo and container",
      "type": "timeseries",
      "description": "Working set, the value the OOM killer compares against the limit.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "fillOpacity": 30,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (repo, container) (label_replace(container_memory_working_set_bytes{job=\"k3s_kubelet_cadvisor\", pod=~\"github-runner-.+\", container!=\"\"}, \"repo\", \"$1\", \"pod\", \"github-runner-(.+)-[0-9]+-[a-z0-9]+-[a-z0-9]+\"))",
          "legendFormat": "{{repo}} {{container}}",
          "refId": "A"
        }
      ],
      "id": 24,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 27
      }
    },
    {
      "title": "Memory vs. limit (highest pod)",
      "type": "timeseries",
      "description": "Working set over the container's memory limit; near 100% the next allocation is an OOM kill.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          },
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (container) (container_memory_working_set_bytes{job=\"k3s_kubelet_cadvisor\", pod=~\"github-runner-.+\", container!=\"\"} / on (pod, container) (container_spec_memory_limit_bytes{job=\"k3s_kubelet_cadvisor\", pod=~\"github-runner-.+\", container!=\"\"} > 0))",
          "legendFormat": "{{container}}",
          "refId": "A"
        }
      ],
      "id": 25,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 27
      }
    },
    {
      "title": "OOM kills per hour",
      "type": "timeseries",
      "description": "Rolling 1h window, by container.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "fillOpacity": 30,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (container) (increase(container_oom_events_total{job=\"k3s_kubelet_cadvisor\", pod=~\"github-runner-.+\", container!=\"\"}[1h]))",
          "legendFormat": "{{container}}",
          "refId": "A"
        }
      ],
      "id": 26,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 27
      }
    },
    {
      "type": "row",
      "title": "k3s-node-2 (runner node)",
      "collapsed": false,
      "panels": [],
      "id": 13,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 35
      }
    },
    {
      "title": "CPU by mode",
      "type": "timeseries",
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (mode) (rate(node_cpu_seconds_total{job=\"k3s_node_exporter\", node=\"k3s-node-2\", mode=~\"user|system|iowait\"}[5m])) / scalar(count(node_cpu_seconds_total{job=\"k3s_node_exporter\", node=\"k3s-node-2\", mode=\"idle\"})) * 100",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ],
      "id": 14,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 36
      }
    },
    {
      "title": "Memory used",
      "type": "timeseries",
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"k3s_node_exporter\", node=\"k3s-node-2\"} / node_memory_MemTotal_bytes{job=\"k3s_node_exporter\", node=\"k3s-node-2\"})",
          "legendFormat": "memory",
          "refId": "A"
        }
      ],
      "id": 15,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 36
      }
    },
    {
      "title": "IO pressure",
      "type": "timeseries",
      "description": "Share of time tasks wait on IO (PSI). 'All tasks stalled' near 100 is the post-reboot seeding storm.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(node_pressure_io_waiting_seconds_total{job=\"k3s_node_exporter\", node=\"k3s-node-2\"}[5m]) * 100",
          "legendFormat": "some task waiting",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(node_pressure_io_stalled_seconds_total{job=\"k3s_node_exporter\", node=\"k3s-node-2\"}[5m]) * 100",
          "legendFormat": "all tasks stalled",
          "refId": "B"
        }
      ],
      "id": 16,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 36
      }
    },
    {
      "title": "VM disk throughput",
      "type": "timeseries",
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(node_disk_read_bytes_total{job=\"k3s_node_exporter\", node=\"k3s-node-2\", device=\"vda\"}[5m])",
          "legendFormat": "read",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(node_disk_written_bytes_total{job=\"k3s_node_exporter\", node=\"k3s-node-2\", device=\"vda\"}[5m])",
          "legendFormat": "write",
          "refId": "B"
        }
      ],
      "id": 17,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 44
      }
    },
    {
      "title": "Load average",
      "type": "timeseries",
      "description": "Load far above CPU usage means processes stuck in IO (state D).",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
