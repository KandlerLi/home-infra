{
  "title": "GitHub Runners",
  "uid": "monitoring-github-runners",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "monitoring"
  ],
  "panels": [
    {
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "title": "Runner Pods ready",
      "type": "stat",
      "description": "ARC creates one runner Pod per job, so this is jobs starting or running right now. 0 when idle.",
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "NO DATA",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_pod_status_ready{namespace=\"ci\", condition=\"true\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      }
    },
    {
      "title": "Runner Pods pending (node-2 full)",
      "type": "stat",
      "description": "Runner Pods whose requests don't fit on k3s-node-2 yet; their jobs wait in GitHub's queue. Briefly non-zero while a Pod starts.",
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "NO DATA",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_pod_status_phase{namespace=\"ci\", phase=\"Pending\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      }
    },
    {
      "title": "ARC listeners ready",
      "type": "stat",
      "description": "One listener per repository's scale set. Below the number of runner repos, that repo's jobs are never picked up.",
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "NO DATA",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kube_pod_status_ready{namespace=\"arc-system\", condition=\"true\", pod=~\".+-listener\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 4,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      }
    },
    {
      "title": "ARC controller/listener restarts (24h)",
      "type": "stat",
      "description": "Should stay 0; a reboot restarts each once.",
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "NO DATA",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"arc-system\"}[24h])) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 5,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      }
    },
    {
      "title": "dind restarts (24h)",
      "type": "stat",
      "description": "dockerd exits are retried inside the container, so a restart means the sidecar itself failed.",
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "NO DATA",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"ci\", container=\"dind\"}[24h])) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 6,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      }
    },
    {
      "title": "k3s-node-2 iowait",
      "type": "stat",
      "description": "High iowait at low CPU means the runners wait on the disk, not on compute.",
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "noValue": "NO DATA",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 20
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg(rate(node_cpu_seconds_total{job=\"k3s_node_exporter\", node=\"k3s-node-2\", mode=\"iowait\"}[5m])) * 100",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 7,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      }
    },
    {
      "title": "Runner Pods ready by repo",
      "type": "state-timeline",
      "description": "Green while a runner Pod of that repo is ready, i.e. running a job.",
      "options": {
        "showValue": "never",
        "rowHeight": 0.8,
        "mergeValues": true,
        "alignValue": "left"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "not ready"
                },
                "1": {
                  "text": "ready"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (repo) (label_replace(kube_pod_status_ready{namespace=\"ci\", condition=\"true\"}, \"repo\", \"$1\", \"pod\", \"(.+)-runner-[a-z0-9]+\"))",
          "legendFormat": "{{repo}}",
          "refId": "A"
        }
      ],
      "id": 8,
      "gridPos": {
        "h": 12,
        "w": 16,
        "x": 0,
        "y": 5
      }
    },
    {
      "title": "Containers waiting right now",
      "type": "table",
      "description": "Empty is good. Shows each runner Pod container stuck in a waiting state and why (ErrImagePull, ContainerCreating, ...).",
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "none"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "indexByName": {
              "runner": 0,
              "container": 1,
              "reason": 2
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (repo, container, reason) (label_replace(kube_pod_container_status_waiting_reason{namespace=\"ci\"}, \"repo\", \"$1\", \"pod\", \"(.+)-runner-[a-z0-9]+\")) > 0",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "id": 9,
      "gridPos": {
        "h": 12,
        "w": 8,
        "x": 16,
        "y": 5
      }
    },
    {
      "type": "row",
      "title": "GitHub's view (API)",
      "collapsed": false,
      "panels": [],
      "id": 27,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      }
    },
    {
      "title": "Online runners per repo",
      "type": "bargauge",
      "description": "Runners GitHub reports as online, idle or busy. A repo at 0 can't run jobs, even if its Pods are ready.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (repo) (github_runners{state=~\"online_.+\"})",
          "legendFormat": "{{repo}}",
          "refId": "A"
        }
      ],
      "id": 28,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 18
      }
    },
    {
      "title": "Runners by GitHub status",
      "type": "timeseries",
      "description": "All runner repos together.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (state) (github_runners)",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ],
      "id": 29,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 18
      }
    },
    {
      "title": "Queued runs by repo",
      "type": "timeseries",
      "description": "Workflow runs waiting for a runner. Normally gone within seconds; a flat line above 0 means no runner takes them.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (repo) (github_actions_queued_runs)",
          "legendFormat": "{{repo}}",
          "refId": "A"
        }
      ],
      "id": 30,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 18
      }
    },
    {
      "title": "Repos the exporter can't poll",
      "type": "stat",
      "description": "Usually an expired token or a runner repo missing from the token's repository list.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(github_runner_exporter_up == 0) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 31,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 18
      }
    },
    {
      "type": "row",
      "title": "Activity",
      "collapsed": false,
      "panels": [],
      "id": 10,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      }
    },
    {
      "title": "Runner Pods per hour by repo (= jobs)",
      "type": "timeseries",
      "description": "One Pod per job, so this counts jobs that ran in the last hour.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count by (repo) (label_replace(max_over_time(kube_pod_created{namespace=\"ci\"}[1h]), \"repo\", \"$1\", \"pod\", \"(.+)-runner-[a-z0-9]+\"))",
          "legendFormat": "{{repo}}",
          "refId": "A"
        }
      ],
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      }
    },
    {
      "title": "dind restarts per hour",
      "type": "timeseries",
      "description": "Anything here outside a reboot means a sidecar is crashing.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (repo) (label_replace(increase(kube_pod_container_status_restarts_total{namespace=\"ci\", container=\"dind\"}[1h]), \"repo\", \"$1\", \"pod\", \"(.+)-runner-[a-z0-9]+\")) > 0",
          "legendFormat": "{{repo}}",
          "refId": "A"
        }
      ],
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      }
    },
    {
      "type": "row",
      "title": "Per container (kubelet cAdvisor)",
      "collapsed": false,
      "panels": [],
      "id": 22,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 35
      }
    },
    {
      "title": "CPU by repo and container",
      "type": "timeseries",
      "description": "Cores, 5m rate, summed over a repo's runner pods.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 30,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (repo, container) (label_replace(rate(container_cpu_usage_seconds_total{job=\"k3s_kubelet_cadvisor\", namespace=\"ci\", container!=\"\"}[5m]), \"repo\", \"$1\", \"pod\", \"(.+)-runner-[a-z0-9]+\"))",
          "legendFormat": "{{repo}} {{container}}",
          "refId": "A"
        }
      ],
      "id": 23,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 36
      }
    },
    {
      "title": "Memory by repo and container",
      "type": "timeseries",
      "description": "Working set, the value the OOM killer compares against the limit.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "fillOpacity": 30,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (repo, container) (label_replace(container_memory_working_set_bytes{job=\"k3s_kubelet_cadvisor\", namespace=\"ci\", container!=\"\"}, \"repo\", \"$1\", \"pod\", \"(.+)-runner-[a-z0-9]+\"))",
          "legendFormat": "{{repo}} {{container}}",
          "refId": "A"
        }
      ],
      "id": 24,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 36
      }
    },
    {
      "title": "Memory vs. limit (highest pod)",
      "type": "timeseries",
      "description": "Working set over the container's memory limit; near 100% the next allocation is an OOM kill.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "fillOpacity": 10
          },
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (container) (container_memory_working_set_bytes{job=\"k3s_kubelet_cadvisor\", namespace=\"ci\", container!=\"\"} / on (pod, container) (container_spec_memory_limit_bytes{job=\"k3s_kubelet_cadvisor\", namespace=\"ci\", container!=\"\"} > 0))",
          "legendFormat": "{{container}}",
          "refId": "A"
        }
      ],
      "id": 25,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 36
      }
    },
    {
      "title": "OOM kills per hour",
      "type": "timeseries",
      "description": "Rolling 1h window, by container.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "fillOpacity": 30,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (container) (increase(container_oom_events_total{job=\"k3s_kubelet_cadvisor\", namespace=\"ci\", container!=\"\"}[1h]))",
          "legendFormat": "{{container}}",
          "refId": "A"
        }
      ],
      "id": 26,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 36
      }
    },
    {
      "type": "row",
      "title": "k3s-node-2 (runner node)",
      "collapsed": false,
      "panels": [],
      "id": 13,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 44
      }
    },
    {
      "title": "CPU by mode",
      "type": "timeseries",
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (mode) (rate(node_cpu_seconds_total{job=\"k3s_node_exporter\", node=\"k3s-node-2\", mode=~\"user|system|iowait\"}[5m])) / scalar(count(node_cpu_seconds_total{job=\"k3s_node_exporter\", node=\"k3s-node-2\", mode=\"idle\"})) * 100",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ],
      "id": 14,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 45
      }
    },
    {
      "title": "Memory used",
      "type": "timeseries",
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
