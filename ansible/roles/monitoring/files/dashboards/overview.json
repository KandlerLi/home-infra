{
  "title": "Overview",
  "uid": "monitoring-overview",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "tags": [
    "monitoring"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Firing alerts",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "text": {
          "valueSize": 48
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "NO DATA",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "legendFormat": "Alerts",
          "instant": true,
          "refId": "A"
        }
      ],
      "description": "Which ones: the table at the bottom."
    },
    {
      "id": 2,
      "title": "Up since (last reboot)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 18,
        "x": 6,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "text": {
          "titleSize": 14,
          "valueSize": 22
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "NO DATA",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - node_boot_time_seconds{job=\"node_exporter\"}",
          "legendFormat": "Homeserver",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - node_boot_time_seconds{job=\"k3s_node_exporter\"}",
          "legendFormat": "{{node}}",
          "instant": true,
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "Infrastructure",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "text": {
          "valueSize": 18
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "NO DATA",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN"
                },
                "1": {
                  "text": "UP"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{job=\"node_exporter\"}",
          "legendFormat": "Homeserver",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_node_status_condition{condition=\"Ready\", status=\"true\"}",
          "legendFormat": "{{node}}",
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(time() - max by (name) (container_last_seen{job=\"cadvisor\", name!=\"\", name!~\"nextcloud-aio-(borgbackup|watchtower)\"}) < bool 120)",
          "legendFormat": "Host containers",
          "instant": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(up)",
          "legendFormat": "Monitoring targets",
          "instant": true,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(github_runners{state=\"offline\"}) == bool 0",
          "legendFormat": "CI runners",
          "instant": true,
          "refId": "E"
        }
      ],
      "description": "Host containers: every Docker container on the homeserver (Nextcloud AIO, monitoring) seen within 2 min. CI runners: none offline at GitHub."
    },
    {
      "id": 4,
      "title": "Public services",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "text": {
          "valueSize": 18
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "NO DATA",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN"
                },
                "1": {
                  "text": "UP"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(probe_success, \"service\", \"$1\", \"instance\", \"https?://([^/]+)/.*\")",
          "legendFormat": "{{service}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "description": "blackbox_exporter's reachability probes. Nextcloud is down by design during its nightly Borg backup."
    },
    {
      "id": 5,
      "title": "Apps (k3s)",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "text": {
          "valueSize": 18
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "NO DATA",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN"
                },
                "1": {
                  "text": "UP"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_deployment_status_replicas_available{namespace=~\"apps|auth\"} >= bool kube_deployment_spec_replicas{namespace=~\"apps|auth\"}",
          "legendFormat": "{{deployment}}",
          "instant": true,
          "refId": "A"
        }
      ],
      "description": "UP = all desired replicas available."
    },
    {
      "id": 6,
      "title": "Cluster services (k3s)",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "text": {
          "valueSize": 18
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "NO DATA",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN"
                },
                "1": {
                  "text": "UP"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kube_deployment_status_replicas_available{namespace=~\"kube-system|monitoring\"} >= bool kube_deployment_spec_replicas{namespace=~\"kube-system|monitoring\"}",
          "legendFormat": "{{deployment}}",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(kube_daemonset_status_number_ready >= bool kube_daemonset_status_desired_number_scheduled, \"daemonset\", \"lb $1\", \"daemonset\", \"svclb-(.+)-[0-9a-f]{8}\")",
          "legendFormat": "{{daemonset}}",
          "instant": true,
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "title": "Backups (time since last success, red past the 26 h alert threshold)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "text": {
          "titleSize": 14,
          "valueSize": 22
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "NO DATA",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 93600
              }
            ]
          },
          "mappings": [],
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - backup:last_success_timestamp_seconds",
          "legendFormat": "{{backup}}",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Firing alerts",
      "type": "table",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "None"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ALERTS{alertstate=\"firing\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "alertstate": true,
              "job": true
            },
            "indexByName": {
              "alertname": 0,
              "severity": 1
            }
          }
        }
      ]
    }
  ]
}
