http:
  routers:
    nextcloud:
      rule: "Host(`{{ shared_ingress_nextcloud_domain }}`)"
      entryPoints:
        - websecure
      service: nextcloud
      middlewares:
        - nextcloud-chain
      tls:
        certResolver: letsencrypt
{% if shared_ingress_agent_enabled | bool %}
{% if shared_ingress_open_webui_enabled | bool %}
    home-agent-api:
      rule: >-
        Host(`{{ shared_ingress_agent_domain }}`)
        && (Path(`/healthz`) || Path(`/v1/chat`))
      priority: 100
      entryPoints:
        - websecure
      service: home-agent
      middlewares:
        - agent-chain
      tls:
        certResolver: letsencrypt
    open-webui:
      rule: "Host(`{{ shared_ingress_agent_domain }}`)"
      priority: 10
      entryPoints:
        - websecure
      service: open-webui
      middlewares:
        - open-webui-chain
      tls:
        certResolver: letsencrypt
{% else %}
    home-agent:
      rule: "Host(`{{ shared_ingress_agent_domain }}`)"
      entryPoints:
        - websecure
      service: home-agent
      middlewares:
        - agent-chain
      tls:
        certResolver: letsencrypt
{% endif %}
{% endif %}
{% if shared_ingress_deluge_enabled | bool %}
    deluge:
      rule: "Host(`{{ shared_ingress_deluge_domain }}`)"
      entryPoints:
        - websecure
      service: deluge
      middlewares:
        - deluge-chain
      tls:
        certResolver: letsencrypt
{% endif %}

  services:
    nextcloud:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "{{ shared_ingress_nextcloud_upstream }}"
{% if shared_ingress_agent_enabled | bool %}
    home-agent:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "{{ shared_ingress_agent_upstream }}"
{% if shared_ingress_open_webui_enabled | bool %}
    open-webui:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "{{ shared_ingress_open_webui_upstream }}"
{% endif %}
{% endif %}
{% if shared_ingress_deluge_enabled | bool %}
    deluge:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "{{ shared_ingress_deluge_upstream }}"
{% endif %}

  middlewares:
    nextcloud-secure-headers:
      headers:
        hostsProxyHeaders:
          - X-Forwarded-Host
        referrerPolicy: same-origin
        customRequestHeaders:
          X-Forwarded-Proto: https
    nextcloud-chain:
      chain:
        middlewares:
          - nextcloud-secure-headers
{% if shared_ingress_agent_enabled | bool %}
    agent-auth:
      basicAuth:
        usersFile: /etc/traefik/users
        realm: Home Infrastructure
        removeHeader: true
    agent-rate-limit:
      rateLimit:
        average: {{ shared_ingress_agent_rate_average }}
        period: {{ shared_ingress_agent_rate_period }}
        burst: {{ shared_ingress_agent_rate_burst }}
    agent-request-limit:
      buffering:
        maxRequestBodyBytes: {{ shared_ingress_agent_max_request_body_bytes }}
        memRequestBodyBytes: {{ shared_ingress_agent_max_request_body_bytes }}
    agent-security-headers:
      headers:
        contentTypeNosniff: true
        frameDeny: true
        referrerPolicy: no-referrer
        permissionsPolicy: "camera=(), microphone=(), geolocation=()"
        stsSeconds: 31536000
        stsIncludeSubdomains: false
    agent-chain:
      chain:
        middlewares:
          - agent-auth
          - agent-rate-limit
          - agent-request-limit
          - agent-security-headers
{% if shared_ingress_open_webui_enabled | bool %}
    open-webui-rate-limit:
      rateLimit:
        average: {{ shared_ingress_open_webui_rate_average }}
        period: {{ shared_ingress_open_webui_rate_period }}
        burst: {{ shared_ingress_open_webui_rate_burst }}
    open-webui-request-limit:
      buffering:
        maxRequestBodyBytes: {{ shared_ingress_open_webui_max_request_body_bytes }}
        memRequestBodyBytes: {{ shared_ingress_open_webui_max_request_body_bytes }}
    open-webui-chain:
      chain:
        middlewares:
          - open-webui-rate-limit
          - open-webui-request-limit
          - agent-security-headers
{% endif %}
{% endif %}
{% if shared_ingress_deluge_enabled | bool %}
    deluge-auth:
      basicAuth:
        usersFile: /etc/traefik/deluge-users
        realm: Home Infrastructure
        removeHeader: true
    deluge-rate-limit:
      rateLimit:
        average: {{ shared_ingress_deluge_rate_average }}
        period: {{ shared_ingress_deluge_rate_period }}
        burst: {{ shared_ingress_deluge_rate_burst }}
    deluge-request-limit:
      buffering:
        maxRequestBodyBytes: {{ shared_ingress_deluge_max_request_body_bytes }}
        memRequestBodyBytes: {{ shared_ingress_deluge_max_request_body_bytes }}
    deluge-security-headers:
      headers:
        contentTypeNosniff: true
        frameDeny: true
        referrerPolicy: no-referrer
        permissionsPolicy: "camera=(), microphone=(), geolocation=()"
        stsSeconds: 31536000
        stsIncludeSubdomains: false
    deluge-chain:
      chain:
        middlewares:
          - deluge-auth
          - deluge-rate-limit
          - deluge-request-limit
          - deluge-security-headers
{% endif %}
