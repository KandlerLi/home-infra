http:
  routers:
    nextcloud:
      rule: "Host(`{{ shared_ingress_nextcloud_domain }}`)"
      entryPoints:
        - websecure
      service: nextcloud
      middlewares:
        - nextcloud-chain
      tls:
        certResolver: letsencrypt
{% if shared_ingress_agent_enabled | bool %}
{% if shared_ingress_open_webui_enabled | bool %}
    home-agent-api:
      rule: >-
        Host(`{{ shared_ingress_agent_domain }}`)
        && (Path(`/healthz`) || Path(`/v1/chat`))
      priority: 100
      entryPoints:
        - websecure
      service: home-agent
      middlewares:
        - agent-chain
      tls:
        certResolver: letsencrypt
    open-webui:
      rule: "Host(`{{ shared_ingress_agent_domain }}`)"
      priority: 10
      entryPoints:
        - websecure
      service: open-webui
      middlewares:
        - open-webui-chain
      tls:
        certResolver: letsencrypt
{% else %}
    home-agent:
      rule: "Host(`{{ shared_ingress_agent_domain }}`)"
      entryPoints:
        - websecure
      service: home-agent
      middlewares:
        - agent-chain
      tls:
        certResolver: letsencrypt
{% endif %}
{% endif %}
{% if shared_ingress_deluge_enabled | bool %}
    deluge:
      rule: "Host(`{{ shared_ingress_deluge_domain }}`)"
      entryPoints:
        - websecure
      service: deluge
      middlewares:
        - deluge-chain
      tls:
        certResolver: letsencrypt
{% endif %}
{% if shared_ingress_grafana_enabled | bool %}
    grafana:
      rule: "Host(`{{ shared_ingress_grafana_domain }}`)"
      entryPoints:
        - websecure
      service: grafana
      middlewares:
        - grafana-chain
      tls:
        certResolver: letsencrypt
{% endif %}
{% if shared_ingress_home_enabled | bool %}
    home:
      rule: "Host(`{{ shared_ingress_home_domain }}`)"
      entryPoints:
        - websecure
      service: home
      middlewares:
        - home-chain
      tls:
        certResolver: letsencrypt
{% endif %}
{% if shared_ingress_apex_redirect_enabled | bool %}
    apex-redirect:
      rule: "Host(`{{ shared_ingress_apex_domain }}`)"
      entryPoints:
        - websecure
      service: noop@internal
      middlewares:
        - apex-redirect
      tls:
        certResolver: letsencrypt
{% endif %}

  services:
    nextcloud:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "{{ shared_ingress_nextcloud_upstream }}"
{% if shared_ingress_agent_enabled | bool %}
    home-agent:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "{{ shared_ingress_agent_upstream }}"
{% if shared_ingress_open_webui_enabled | bool %}
    open-webui:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "{{ shared_ingress_open_webui_upstream }}"
{% endif %}
{% endif %}
{% if shared_ingress_deluge_enabled | bool %}
    deluge:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "{{ shared_ingress_deluge_upstream }}"
{% endif %}
{% if shared_ingress_grafana_enabled | bool %}
    grafana:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "{{ shared_ingress_grafana_upstream }}"
{% endif %}
{% if shared_ingress_home_enabled | bool %}
    home:
      loadBalancer:
        passHostHeader: true
        servers:
          - url: "{{ shared_ingress_home_upstream }}"
{% endif %}

  middlewares:
    nextcloud-secure-headers:
      headers:
        hostsProxyHeaders:
          - X-Forwarded-Host
        referrerPolicy: same-origin
        customRequestHeaders:
          X-Forwarded-Proto: https
    nextcloud-chain:
      chain:
        middlewares:
          - nextcloud-secure-headers
{% if shared_ingress_agent_enabled | bool or shared_ingress_deluge_enabled | bool or shared_ingress_grafana_enabled | bool or shared_ingress_home_enabled | bool %}
    shared-auth:
      basicAuth:
        usersFile: /etc/traefik/users
        realm: Home Infrastructure
        removeHeader: true
{% endif %}
{% if shared_ingress_agent_enabled | bool %}
    agent-rate-limit:
      rateLimit:
        average: {{ shared_ingress_agent_rate_average }}
        period: {{ shared_ingress_agent_rate_period }}
        burst: {{ shared_ingress_agent_rate_burst }}
    agent-request-limit:
      buffering:
        maxRequestBodyBytes: {{ shared_ingress_agent_max_request_body_bytes }}
        memRequestBodyBytes: {{ shared_ingress_agent_max_request_body_bytes }}
    agent-security-headers:
      headers:
        contentTypeNosniff: true
        frameDeny: true
        referrerPolicy: no-referrer
        permissionsPolicy: "camera=(), microphone=(), geolocation=()"
        stsSeconds: 31536000
        stsIncludeSubdomains: false
    agent-chain:
      chain:
        middlewares:
          - shared-auth
          - agent-rate-limit
          - agent-request-limit
          - agent-security-headers
{% if shared_ingress_open_webui_enabled | bool %}
    open-webui-rate-limit:
      rateLimit:
        average: {{ shared_ingress_open_webui_rate_average }}
        period: {{ shared_ingress_open_webui_rate_period }}
        burst: {{ shared_ingress_open_webui_rate_burst }}
    open-webui-request-limit:
      buffering:
        maxRequestBodyBytes: {{ shared_ingress_open_webui_max_request_body_bytes }}
        memRequestBodyBytes: {{ shared_ingress_open_webui_max_request_body_bytes }}
    open-webui-chain:
      chain:
        middlewares:
          - open-webui-rate-limit
          - open-webui-request-limit
          - agent-security-headers
{% endif %}
{% endif %}
{% set shared_ingress_rate_limited_routes = [
  {'name': 'deluge', 'enabled': shared_ingress_deluge_enabled | bool, 'rate_average': shared_ingress_deluge_rate_average, 'rate_period': shared_ingress_deluge_rate_period, 'rate_burst': shared_ingress_deluge_rate_burst, 'max_request_body_bytes': shared_ingress_deluge_max_request_body_bytes},
  {'name': 'grafana', 'enabled': shared_ingress_grafana_enabled | bool, 'rate_average': shared_ingress_grafana_rate_average, 'rate_period': shared_ingress_grafana_rate_period, 'rate_burst': shared_ingress_grafana_rate_burst, 'max_request_body_bytes': shared_ingress_grafana_max_request_body_bytes},
  {'name': 'home', 'enabled': shared_ingress_home_enabled | bool, 'rate_average': shared_ingress_home_rate_average, 'rate_period': shared_ingress_home_rate_period, 'rate_burst': shared_ingress_home_rate_burst, 'max_request_body_bytes': shared_ingress_home_max_request_body_bytes},
] %}
{% for route in shared_ingress_rate_limited_routes if route.enabled %}
    {{ route.name }}-rate-limit:
      rateLimit:
        average: {{ route.rate_average }}
        period: {{ route.rate_period }}
        burst: {{ route.rate_burst }}
    {{ route.name }}-request-limit:
      buffering:
        maxRequestBodyBytes: {{ route.max_request_body_bytes }}
        memRequestBodyBytes: {{ route.max_request_body_bytes }}
    {{ route.name }}-security-headers:
      headers:
        contentTypeNosniff: true
        frameDeny: true
        referrerPolicy: no-referrer
        permissionsPolicy: "camera=(), microphone=(), geolocation=()"
        stsSeconds: 31536000
        stsIncludeSubdomains: false
    {{ route.name }}-chain:
      chain:
        middlewares:
          - shared-auth
          - {{ route.name }}-rate-limit
          - {{ route.name }}-request-limit
          - {{ route.name }}-security-headers
{% endfor %}
{% if shared_ingress_apex_redirect_enabled | bool %}
    apex-redirect:
      redirectRegex:
        regex: '^https://{{ shared_ingress_apex_domain | regex_escape }}/(.*)'
        replacement: 'https://{{ shared_ingress_apex_redirect_target_host }}/${1}'
        permanent: true
{% endif %}
