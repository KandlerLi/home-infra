// Managed by Ansible (home-infra, unattended_upgrades role).
// #clear drops the list from Debian's 50unattended-upgrades, which also takes point releases.
#clear Unattended-Upgrade::Origins-Pattern;
Unattended-Upgrade::Origins-Pattern {
{% for pattern in unattended_upgrades_origins_patterns %}
        "{{ pattern }}";
{% endfor %}
};
Unattended-Upgrade::Automatic-Reboot "false";
