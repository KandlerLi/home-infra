[Unit]
Description=IPv6-to-Blocky DNS relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ blocky_ipv6_relay_service_user }}
Group={{ blocky_ipv6_relay_service_user }}
Environment="BACKEND_HOST={{ blocky_ipv6_relay_backend_host }}"
Environment="BACKEND_PORT={{ blocky_ipv6_relay_backend_port }}"
Environment="LISTEN_PORT=53"
ExecStart=/usr/bin/python3 {{ blocky_ipv6_relay_install_dir }}/blocky_ipv6_relay.py
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
MemoryMax=64M
TasksMax=32

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
# The one real departure from every sibling unit's own empty
# CapabilityBoundingSet/AmbientCapabilities: this service needs to bind
# port 53 (privileged) as a non-root user. Ambient capabilities must be
# a subset of the bounding set, so both are set to the same single
# capability -- the systemd-native equivalent of the now-deleted Docker
# blocky role's own cap_drop: ALL + capabilities: [NET_BIND_SERVICE]
# shape for the exact same problem.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_INET AF_INET6
# Deliberately no IPAddressAllow= here -- unlike a loopback-only
# service, this one's whole job is answering real IPv6 clients on the
# LAN. blocky_ipv6_relay_lan_prefix's own ip6tables INPUT rule (this
# role's tasks/main.yml) is the actual access boundary, not a systemd
# address allowlist -- and the relay's own IPV6_V6ONLY socket option
# (blocky_ipv6_relay.py's own Ipv6OnlyMixin) keeps it from answering
# IPv4 traffic that rule was never scoped to restrict.
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
