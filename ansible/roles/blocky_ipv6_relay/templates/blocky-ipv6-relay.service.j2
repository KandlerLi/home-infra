[Unit]
Description=IPv6-to-Blocky DNS relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ blocky_ipv6_relay_service_user }}
Group={{ blocky_ipv6_relay_service_user }}
Environment="BACKEND_HOST={{ blocky_ipv6_relay_backend_host }}"
Environment="BACKEND_PORT={{ blocky_ipv6_relay_backend_port }}"
Environment="LISTEN_PORT=53"
ExecStart=/usr/bin/python3 {{ blocky_ipv6_relay_install_dir }}/blocky_ipv6_relay.py
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
MemoryMax=64M
TasksMax=32

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
# CAP_NET_BIND_SERVICE only, to bind port 53 as a non-root user.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_INET AF_INET6
# No IPAddressAllow=: the ip6tables rule is the access boundary.
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
