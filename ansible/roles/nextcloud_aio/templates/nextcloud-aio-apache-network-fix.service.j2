[Unit]
Description=Reconnect nextcloud-aio-apache to the nextcloud-aio Docker network if it dropped off
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
# Headroom over the script's 600s wait for Apache.
TimeoutStartSec=650
# root: docker.sock access is root-equivalent anyway.
User=root
ExecStart={{ nextcloud_aio_apache_network_fix_install_path }}

[Install]
WantedBy=multi-user.target
