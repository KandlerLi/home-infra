#!/bin/bash
# Managed by Ansible (aux_backup role); hand edits are overwritten.
set -euo pipefail

DEST_DIR="{{ aux_backup_dest_dir }}"
RETENTION_DAYS="{{ aux_backup_retention_days }}"
DATE="$(date +%Y%m%d-%H%M%S)"

mkdir -p "${DEST_DIR}"

# One EXIT trap for all staging dirs: bash keeps only the last handler.
STAGING_DIRS=()
cleanup() {
  for d in "${STAGING_DIRS[@]:-}"; do
    [ -n "$d" ] && rm -rf "$d"
  done
}
trap cleanup EXIT

{% for source in aux_backup_sources %}
if [ ! -d "{{ source.path }}" ] || [ -z "$(ls -A "{{ source.path }}" 2>/dev/null)" ]; then
  echo "{{ source.name }}: {{ source.path }} is missing or empty -- refusing to write an empty/misleading backup" >&2
  exit 1
fi
echo "Backing up {{ source.name }} ({{ source.path }})..."
{% if source.sqlite_files is defined and source.sqlite_files | length > 0 %}
# {{ source.name }} has a live WAL-mode SQLite database: snapshot it with the online backup API.
STAGING_DIR="$(mktemp -d)"
STAGING_DIRS+=("$STAGING_DIR")
STAGING_TARGET="$STAGING_DIR/$(basename "{{ source.path }}")"
mkdir -p "$STAGING_TARGET"
rsync -a \
{% for db in source.sqlite_files %}
  --exclude="{{ db }}" --exclude="{{ db }}-shm" --exclude="{{ db }}-wal" \
{% endfor %}
  "{{ source.path }}/" "$STAGING_TARGET/"
{% for db in source.sqlite_files %}
echo "Snapshotting {{ db }} via SQLite's own online backup API..."
python3 -c '
import sqlite3
import sys

source_conn = sqlite3.connect(sys.argv[1])
dest_conn = sqlite3.connect(sys.argv[2])
with dest_conn:
    source_conn.backup(dest_conn)
source_conn.close()
dest_conn.close()
' "{{ source.path }}/{{ db }}" "$STAGING_TARGET/{{ db }}"
{% endfor %}
tar -czf "${DEST_DIR}/{{ source.name }}-${DATE}.tar.gz" -C "$STAGING_DIR" "$(basename "{{ source.path }}")"
rm -rf "$STAGING_DIR"
{% else %}
tar -czf "${DEST_DIR}/{{ source.name }}-${DATE}.tar.gz" -C "$(dirname "{{ source.path }}")" "$(basename "{{ source.path }}")"
{% endif %}
{% endfor %}

echo "Pruning archives older than ${RETENTION_DAYS} days..."
find "${DEST_DIR}" -maxdepth 1 -name '*.tar.gz' -mtime "+${RETENTION_DAYS}" -delete

# Last step, so only a successful run updates it.
touch "${DEST_DIR}/.last-success"

echo "aux_backup finished successfully."
