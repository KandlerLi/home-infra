[Unit]
Description=Back up Deluge config and Open WebUI data to the local backup disk
# The HDD mounts come from the storage role's RequiresMountsFor drop-in; local-fs.target doesn't cover nofail mounts.
After=local-fs.target
Requires=local-fs.target

[Service]
Type=oneshot
# Root on purpose: it reads directories owned by several service accounts. See the README.
ExecStart={{ aux_backup_install_dir }}/aux-backup.sh
TimeoutStartSec=1800

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ReadWritePaths={{ aux_backup_dest_dir }}
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
