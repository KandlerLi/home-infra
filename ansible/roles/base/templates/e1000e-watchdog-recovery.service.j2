[Unit]
Description=Recover the e1000e NIC after a watchdog-detected hardware hang
After=network.target

[Service]
Type=simple
# Not sandboxed: it needs /sys/bus/pci and the kernel journal.
ExecStart={{ base_e1000e_watchdog_recovery_install_dir }}/e1000e-watchdog-recovery.sh
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
